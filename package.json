{
	"name": "vscode-nbt",
	"displayName": "NBT Viewer — Modded Resources",
	"description": "View Minecraft NBT and 3D structures with local mod and resource pack assets",
	"version": "0.10.1",
	"preview": true,
	"publisher": "hi4444",
	"repository": {
		"type": "git",
		"url": "https://github.com/hi4444/vscode-nbt.git"
	},
	"engines": {
		"vscode": "^1.85.0"
	},
	"categories": [
		"Other"
	],
	"activationEvents": [
		"onCustomEditor:nbtEditor.nbt",
		"onCommand:nbtViewer.selectInstance",
		"onCommand:nbtViewer.scanMods",
		"onCommand:nbtViewer.reloadResources",
		"onCommand:nbtViewer.clearCache",
		"onCommand:nbtViewer.showDiagnostics",
		"onView:nbtResources"
	],
	"main": "./out/extension.js",
	"capabilities": {
		"untrustedWorkspaces": {
			"supported": true
		}
	},
	"contributes": {
		"commands": [
			{
				"command": "nbtViewer.selectInstance",
				"title": "NBT Viewer: Select Minecraft Instance"
			},
			{
				"command": "nbtViewer.scanMods",
				"title": "NBT Viewer: Scan Installed Mods"
			},
			{
				"command": "nbtViewer.reloadResources",
				"title": "NBT Viewer: Reload Modded Resources"
			},
			{
				"command": "nbtViewer.clearCache",
				"title": "NBT Viewer: Clear Asset Cache"
			},
			{
				"command": "nbtViewer.showDiagnostics",
				"title": "NBT Viewer: Show Resource Diagnostics"
			}
		],
		"views": {
			"explorer": [
				{
					"id": "nbtResources",
					"name": "NBT Resources"
				}
			]
		},
		"configuration": {
			"title": "NBT Viewer",
			"properties": {
				"nbtViewer.askForInstanceOnOpen": {
					"type": "string",
					"enum": ["always", "whenMissing", "never"],
					"default": "always",
					"enumDescriptions": ["Ask for the modpack folder whenever an NBT document opens.", "Ask only when no instance is selected.", "Use the selected instance without asking."],
					"description": "When to ask for the modpack folder used to render NBT files. Cancel keeps the current selection."
				},
				"nbtViewer.selectedInstance": {
					"type": "string",
					"default": "",
					"scope": "machine",
					"description": "Selected local Minecraft instance directory."
				},
				"nbtViewer.selectedVersion": {
					"type": "string",
					"default": "",
					"scope": "machine",
					"description": "Version of the selected launcher profile; leave empty for automatic detection."
				},
				"nbtViewer.instancePaths": {
					"type": "array",
					"items": {
						"type": "string"
					},
					"default": [],
					"scope": "machine",
					"description": "Additional launcher instance roots or individual Minecraft instance directories."
				},
				"nbtViewer.resourcePacks": {
					"type": "array",
					"items": {
						"type": "string"
					},
					"default": [],
					"scope": "machine",
					"description": "Additional local ZIP or directory packs, in low-to-high priority order (last wins)."
				},
				"nbtViewer.fallbackTint": {
					"type": "array",
					"items": {
						"type": "number",
						"minimum": 0,
						"maximum": 1
					},
					"minItems": 3,
					"maxItems": 3,
					"default": [
						1,
						1,
						1
					],
					"description": "RGB tint for modded model faces with tint indices."
				}
			}
		},
		"customEditors": [
			{
				"viewType": "nbtEditor.nbt",
				"displayName": "NBT Viewer",
				"selector": [
					{
						"filenamePattern": "*.nbt"
					},
					{
						"filenamePattern": "*.dat"
					},
					{
						"filenamePattern": "*.dat_old"
					},
					{
						"filenamePattern": "*.mca"
					},
					{
						"filenamePattern": "*.mcstructure"
					},
					{
						"filenamePattern": "*.schematic"
					},
					{
						"filenamePattern": "*.litematic"
					},
					{
						"filenamePattern": "*.schem"
					}
				],
				"priority": "default"
			}
		]
	},
	"scripts": {
		"vscode:prepublish": "npm run build",
		"build": "rollup --config",
		"dev": "rollup --config --watch",
		"lint": "eslint . --ext .ts",
		"typecheck": "tsc --noEmit && tsc -p tsconfig.assets.json",
		"test": "tsx --test tests/*.test.ts",
		"test:render": "playwright test",
		"package": "vsce package --no-dependencies"
	},
	"dependencies": {
		"deepslate": "^0.26.1",
		"env-paths": "^2.2.1",
		"follow-redirects": "^1.14.8",
		"gl-matrix": "^3.4.3",
		"tar": "^7.5.22",
		"vscode-codicons": "^0.0.14",
		"yauzl": "^3.4.0"
	},
	"devDependencies": {
		"@playwright/test": "^1.64.0",
		"@rollup/plugin-commonjs": "^20.0.0",
		"@rollup/plugin-node-resolve": "^13.0.6",
		"@rollup/plugin-typescript": "^12.3.0",
		"@types/follow-redirects": "^1.14.0",
		"@types/node": "^22.20.5",
		"@types/pngjs": "^6.0.5",
		"@types/vscode": "^1.46.0",
		"@types/yauzl": "^3.4.0",
		"@typescript-eslint/eslint-plugin": "^8.71.1",
		"@typescript-eslint/parser": "^8.71.1",
		"@vscode/vsce": "^4.0.0",
		"eslint": "^8.2.0",
		"pngjs": "^7.0.0",
		"rollup": "^2.59.0",
		"ts-node": "^10.4.0",
		"tslib": "^2.8.1",
		"tsx": "^4.23.15",
		"typescript": "^5.9.3"
	}
}
